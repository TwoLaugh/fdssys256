# Normalise line endings so Windows checkouts (core.autocrlf=true) don't break the
# Linux build container. The e2e/docker-compose app image runs `./mvnw` inside
# eclipse-temurin; if mvnw is checked out CRLF, /bin/sh treats the trailing \r as part
# of each command and the image build dies with "exit code: 127". Keep the wrapper and
# all shell scripts LF; keep Windows batch wrappers CRLF.
mvnw text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source files: store and check out as LF on every platform so a Windows checkout
# (core.autocrlf=true) can't commit CRLF blobs that fail the Linux CI spotless:check
# (google-java-format; its default GIT_ATTRIBUTES line-ending policy resolves to LF).
*.java text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
